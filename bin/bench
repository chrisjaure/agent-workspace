#!/bin/sh
set -eu

usage() {
    printf 'Usage: bench edit [file] | bench diff [--delta-tui]\n' >&2
}

run_editor() {
    file=$1
    editor_command=${EDITOR:-vim}
    # Treat EDITOR as a shell command so configured options are supported.
    # The file path is expanded only after being quoted in the evaluated command.
    eval "exec $editor_command \"\$file\""
}

# Resolve the script path so the picker can relaunch this command in a pane,
# even when the current directory is a selected project rather than this repo.
case $0 in
    */*) script_path=$0 ;;
    *) script_path=$(command -v "$0") ;;
esac
case $script_path in
    /*) ;;
    *) script_path=$PWD/$script_path ;;
esac

# Keep Zellij-specific pane creation at this boundary; the modes it launches
# perform their work without calling Zellij themselves.
open_floating_pane() {
    exec zellij action new-pane \
        --floating \
        --close-on-exit \
        --width '80%' \
        --height '80%' \
        -- "$@"
}

file_candidates() {
    # --hidden includes dotfiles while ripgrep continues honoring ignore rules.
    rg --files --hidden --glob '!.git' |
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        path=${path#./}
        filename=${path##*/}
        display_path=$path

        # Keep the last two parent directories when a path is deeply nested.
        parent=${path%/*}
        case $parent in
            */*)
                grandparent=${parent%/*}
                case $grandparent in
                    */*) display_path="…/${grandparent##*/}/${parent##*/}/$filename" ;;
                esac
                ;;
        esac

        case $display_path in
            */*) printf '\033[2m%s/\033[0m\033[1m%s\033[0m\t%s\n' "${display_path%/*}" "$filename" "$path" ;;
            *) printf '\033[1m%s\033[0m\t%s\n' "$filename" "$path" ;;
        esac
    done
}

case "${1-}" in
    diff)
        shift
        case $# in
            0)
                open_floating_pane git diff HEAD
                ;;
            1)
                if [ "$1" != "--delta-tui" ]; then
                    usage
                    exit 2
                fi
                open_floating_pane git \
                    -c 'pager.diff=delta --tui' \
                    -c delta.start-folded=true \
                    diff HEAD
                ;;
            *)
                usage
                exit 2
                ;;
        esac
        ;;
    edit)
        shift
        if [ "$#" -gt 1 ]; then
            usage
            exit 2
        fi
        if [ "$#" -eq 1 ]; then
            open_floating_pane "$script_path" _open-editor "$1"
        else
            open_floating_pane "$script_path" _pick-and-edit
        fi
        ;;
    _pick-and-edit)
        if ! command -v fzf >/dev/null 2>&1; then
            printf 'Required command not found: fzf\n' >&2
            exit 127
        fi
        if ! command -v bat >/dev/null 2>&1; then
            printf 'Required command not found: bat\n' >&2
            exit 127
        fi
        if ! command -v rg >/dev/null 2>&1; then
            printf 'Required command not found: rg\n' >&2
            exit 127
        fi
        if ! file=$(file_candidates | fzf --ansi --layout=reverse --delimiter='\t' \
            --with-nth=1 --accept-nth=2 \
            --prompt='Edit> ' \
            --preview 'bat --color=always --style=header,numbers --line-range=:200 -- {2}'); then
            # Choosing nothing or cancelling the picker should be a no-op.
            exit 0
        fi
        [ -n "$file" ] || exit 0
        exec "$script_path" _open-editor "$file"
        ;;
    _open-editor)
        shift
        if [ "$#" -ne 1 ]; then
            usage
            exit 2
        fi
        run_editor "$1"
        ;;
    *)
        usage
        exit 2
        ;;
esac
