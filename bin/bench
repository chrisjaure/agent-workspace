#!/bin/sh
set -eu

case $0 in
    */*) script_path=$0 ;;
    *) script_path=$(command -v "$0") ;;
esac
case $script_path in
    /*) ;;
    *) script_path=$PWD/$script_path ;;
esac
bench_dir=$(CDPATH='' cd -P "$(dirname "$script_path")" && pwd)
commands_dir=$bench_dir/bench-commands

valid_command_name() {
    case $1 in
        ''|[!a-zA-Z0-9]*|*[!a-zA-Z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

command_description() {
    description=$(sed -n '2{s/^# bench-description: //p; q;}' "$1")
    if [ -z "$description" ]; then
        description='No description provided.'
    fi
    printf '%s' "$description"
}

command_entries() {
    for command_path in "$commands_dir"/*; do
        [ -f "$command_path" ] && [ -x "$command_path" ] || continue
        command_name=${command_path##*/}
        valid_command_name "$command_name" || continue
        description=$(command_description "$command_path")
        printf '%s\t%s\n' "$command_name" "$description"
    done
}

print_commands() {
    printf 'Usage: bench [command] [arguments...]\n'
    printf 'Run without arguments in a terminal to choose a command.\n\n'
    printf 'Available commands:\n'
    entries=$(command_entries)
    if [ -z "$entries" ]; then
        printf '  (none)\n'
        return
    fi
    printf '%s\n' "$entries" |
    while IFS="$(printf '\t')" read -r command_name description; do
        printf '  %-12s %s\n' "$command_name" "$description"
    done
}

usage() {
    print_commands >&2
}

pick_command() {
    entries=$(command_entries)
    if [ -z "$entries" ]; then
        print_commands
        exit 0
    fi

    if selection=$(printf '%s\n' "$entries" | fzf \
        --delimiter="$(printf '\t')" \
        --with-nth=1,2 \
        --accept-nth=1 \
        --layout=reverse \
        --prompt='bench> '); then
        :
    else
        fzf_status=$?
        case $fzf_status in
            1|130) exit 0 ;;
            *)
                printf 'bench: fzf exited with status %s\n' "$fzf_status" >&2
                exit "$fzf_status"
                ;;
        esac
    fi

    [ -n "$selection" ] || exit 0
    valid_command_name "$selection" || exit 2
    command_path=$commands_dir/$selection
    if [ -f "$command_path" ] && [ -x "$command_path" ]; then
        exec "$command_path"
    fi

    printf 'bench: selected command is no longer available: %s\n' "$selection" >&2
    exit 2
}

if [ "$#" -eq 0 ]; then
    if [ -t 0 ] && [ -t 1 ] && command -v fzf >/dev/null 2>&1; then
        pick_command
    fi
    print_commands
    exit 0
fi

case $1 in
    -h|--help)
        if [ "$#" -eq 1 ]; then
            print_commands
            exit 0
        fi
        ;;
esac

command_name=$1
shift
if ! valid_command_name "$command_name"; then
    printf 'Invalid bench command: %s\n' "$command_name" >&2
    usage
    exit 2
fi

command_path=$commands_dir/$command_name
if [ -f "$command_path" ] && [ -x "$command_path" ]; then
    exec "$command_path" "$@"
fi

printf 'Unknown bench command: %s\n' "$command_name" >&2
usage
exit 2
