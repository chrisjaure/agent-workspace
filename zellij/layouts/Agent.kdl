layout {
    cwd "."
    tab name="Workspace" focus=true {
        pane size=1 borderless=true {
            plugin location="zellij:bars" {
                role "tab-bar"
            }
        }
        pane command="workspace-agent" cwd="." size="75%" {
            start_suspended true
        }
        pane cwd="." size="25%"
        pane size=1 borderless=true {
            plugin location="zellij:bars" {
                role "status-bar"
            }
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:bars" {
                role "tab-bar"
            }
        }
        pane command="sh" close_on_exit=true {
            args "-c" "d=$(\"$AGENT_WORKSPACE_DIR/zellij/scripts/pick-cwd.sh\"); if [ -n \"$d\" ]; then name=$(basename -- \"$d\"); zellij action new-tab --layout AgentTab --cwd \"$d\" --name \"$name\"; fi"
        }
        pane size=1 borderless=true {
            plugin location="zellij:bars" {
                role "status-bar"
            }
        }
    }
}
